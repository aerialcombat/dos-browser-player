{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "tests/*.test.ts", "vite.config.ts"]
}
